{
  "name": "psio",
  "version": "0.1.0",
  "description": "PSIO serialization for JavaScript and TypeScript: PSSZ, key, JSON / I-JSON and pjson from a Schema IR or typed definitions",
  "keywords": [
    "psio",
    "pssz",
    "serialization",
    "schema",
    "i-json",
    "pjson"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/*.js.map",
    "dist/*.d.ts.map",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "npm run build && node --test dist/test/*.js",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "hash-wasm": "4.12.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
